{
  "name": "aib-life-proto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIB Life - Schedule 23 SLA governance on TCS BaNCS extracts",
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node scripts/python-server.js",
    "server:node": "node server/index.js",
    "dev:node": "node scripts/dev.js --node-backend",
    "build": "vite build",
    "preview": "npm run build && npm run server",
    "reset": "node scripts/reset.js",
    "bedrock:check": "python -m backend.check_bedrock",
    "bedrock:check:node": "node scripts/check-bedrock.js",
    "test": "node --test \"server/**/*.test.js\"",
    "test:python": "python -m unittest discover -s backend/tests -v",
    "verify:real": "node scripts/verify-real.js",
    "mapping:extract": "node scripts/extract-mapping.js",
    "data:load": "node scripts/load-data.js",
    "data:extend-october": "node scripts/extend-demo-as-of.js && node scripts/load-data.js"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.4",
    "@aws-sdk/client-bedrock-runtime": "^3.1127.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
